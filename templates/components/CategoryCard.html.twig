
<article
    {{ attributes }}
    class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 flex flex-col"
>
    <div class="h-48 relative overflow-hidden">
        <img
            src="{{ category.image }}"
            alt="Développement"
            class="w-full h-full object-cover"
        >
        <span
            class="absolute bottom-3 left-3 bg-[#e01e6e] text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider"
        >{{ category.articles|length }}
            Articles</span>
    </div>
    <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-xl font-bold text-gray-900 uppercase tracking-wide mb-2">{{ category.title }}</h3>
        <p class="text-gray-500 text-sm mb-6 flex-grow">{{ category.description }}</p>
        <a
            href="{{ path('category.show', {slug: category.slug}) }}"
            class="text-[#e01e6e] font-bold text-sm uppercase tracking-wider hover:text-[#c4185e] transition-colors flex items-center gap-1"
        >Explorer
            <span class="text-lg">→</span></a>
    </div>
</article>

