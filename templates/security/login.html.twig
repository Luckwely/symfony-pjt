{% extends 'layouts/auth_base.html.twig' %}

{% block title %}Se connecter – MonBlog{% endblock %}

{% block body %}
    <div class="flex items-center justify-center h-screen w-full bg-gray-100">
        <div class="w-full max-w-3xl bg-white">
            <div class="w-full bg-gray-100 px-4 py-10 sm:px-8 sm:py-12">
                <header class="text-center">
                    <a href="{{ path('app_home') }}" class="text-3xl font-extrabold tracking-wide text-slate-900">Mon<span
                            class="text-[#f5329e]"
                        >Blog</span></a>
                    <h1 class="mt-5 text-2xl font-extrabold uppercase tracking-widest text-slate-900 sm:text-3xl">
                        Se <span class="text-[#f5329e]">connecter</span>
                    </h1>
                    <p class="mt-3 text-sm italic text-gray-500">Ravi de vous retrouver</p>
                </header>

                {% if error %}
                    <div
                        class="mx-auto mt-6 max-w-xl rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
                        role="alert"
                    >
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="mx-auto mt-6 max-w-xl text-center text-sm text-slate-700">
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }}.
                        <a class="font-semibold text-[#f5329e] hover:underline" href="{{ logout_path() }}">Se déconnecter</a>
                    </div>
                {% endif %}

                <main class="mx-auto mt-10 max-w-xl rounded-2xl bg-white p-6 shadow-xl shadow-slate-300/60 sm:p-9">
                    <form method="post">
                        <div>
                            <label for="username" class="mb-2 block text-sm font-semibold text-slate-700">Adresse
                                e-mail</label>
                            <input
                                type="email"
                                value="{{ last_username }}"
                                name="_username"
                                id="username"
                                class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-slate-900 placeholder-gray-400 transition hover:border-gray-300 focus:border-brand focus:outline-none focus:ring-4 focus:ring-brand/20"
                                placeholder="votre@email.com"
                                autocomplete="email"
                                required
                                autofocus
                            >
                        </div>

                        <div class="mt-5">
                            <label for="password" class="mb-2 block text-sm font-semibold text-slate-700">Mot de
                                passe</label>
                            <input
                                type="password"
                                name="_password"
                                id="password"
                                class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-slate-900 placeholder-gray-400 transition hover:border-gray-300 focus:border-brand focus:outline-none focus:ring-4 focus:ring-brand/20"
                                placeholder="••••••••"
                                autocomplete="current-password"
                                required
                            >
                        </div>

                        <input
                            type="hidden"
                            name="_csrf_token"
                            data-controller="csrf-protection"
                            value="{{ csrf_token('authenticate') }}"
                        >

                        <button
                            class="mt-6 w-full rounded-lg bg-[#f5329e] py-3.5 text-sm font-bold uppercase tracking-wide text-white shadow-md shadow-[#f5329e]/30 transition hover:bg-[#f5329e]-[#d9217f] hover:shadow-lg active:scale-[.99] focus:outline-none focus:ring-4 focus:ring-[#f5329e]/40"
                            type="submit"
                        >
                            Se connecter
                        </button>
                    </form>

                    <div class="mt-8 flex items-center gap-4">
                        <span class="h-px flex-1 bg-gray-200"></span>
                        <span class="text-xs font-semibold uppercase text-gray-400">ou</span>
                        <span class="h-px flex-1 bg-gray-200"></span>
                    </div>

                    <p class="mt-5 text-center text-sm text-slate-700">
                    
                        <a
                            href="{{ path('app_forgot_password_request') }}"
                            class="ml-1 font-bold uppercase text-[#f5329e] hover:underline"
                        >Mot de passe oublie?</a>
                    </p>

                    <p class="mt-5 text-center text-sm text-slate-700">
                        Pas encore de compte ?
                        <a
                            href="{{ path('app_register') }}"
                            class="ml-1 font-bold uppercase text-[#f5329e] hover:underline"
                        >Créer un compte</a>
                    </p>
                </main>
            </div>
        </div>
        <section class="waves" aria-hidden="true" role="separator">
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" focusable="false" style="pointer-events: none" class="wave" width="100%" height="50px" preserveAspectRatio="none" viewBox="0 0 1920 75">
                <defs>
                    <style>
                        .a {
                            fill: none;
                        }
                        .b {
                            clip-path: url(#a);
                        }
                        .c,
                        .d {
                            fill: var(--light-color);
                        }
                        .d {
                            opacity: 0.5;
                            isolation: isolate;
                        }
                        @keyframes waveMotion {
                            0% {
                                transform: scaleX(1) translateX(0);
                            }
                            50% {
                                transform: scaleX(1.5) translateX(-30%);
                            }
                            0% {
                                transform: scaleX(1) translateX(0);
                            }
                        }

                        .b:nth-child(5) {
                            animation: waveMotion 14s infinite alternate;
                        }
                        .b:nth-child(2) {
                            animation: waveMotion 12s infinite alternate;
                        }
                        .b:nth-child(3) {
                            animation: waveMotion 13s infinite alternate;
                        }
                        .b:nth-child(4) {
                            animation: waveMotion 8s infinite alternate;
                        }

                        @media (prefers-reduced-motion) {
                            .b {
                                animation: none !important;
                            }
                        }
                    </style>
                    <clipPath id="a"><rect class="a" width="1920" height="75"></rect></clipPath>
                </defs>
                <g class="b">
                    <path class="c" d="M1963,327H-105V65A2647.49,2647.49,0,0,1,431,19c217.7,3.5,239.6,30.8,470,36,297.3,6.7,367.5-36.2,642-28a2511.41,2511.41,0,0,1,420,48"></path>
                </g>
                <g class="b">
                    <path class="d" d="M-127,404H1963V44c-140.1-28-343.3-46.7-566,22-75.5,23.3-118.5,45.9-162,64-48.6,20.2-404.7,128-784,0C355.2,97.7,341.6,78.3,235,50,86.6,10.6-41.8,6.9-127,10"></path>
                </g>
                <g class="b">
                    <path class="d" d="M1979,462-155,446V106C251.8,20.2,576.6,15.9,805,30c167.4,10.3,322.3,32.9,680,56,207,13.4,378,20.3,494,24"></path>
                </g>
                <g class="b">
                    <path class="d" d="M1998,484H-243V100c445.8,26.8,794.2-4.1,1035-39,141-20.4,231.1-40.1,378-45,349.6-11.6,636.7,73.8,828,150"></path>
                </g>
            </svg>        
        </section>
    </div>
{% endblock %}
