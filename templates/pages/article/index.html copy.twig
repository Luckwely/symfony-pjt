{% extends 'layouts/base.html.twig' %}
{% block title %}Article{% endblock %}

{% block body %}
    <div class="flex items-center gap-4">
        <h1 class="font-bold text-3xl">Article index</h1>
        <a href="{{ path('app_article_new') }}" class="text-black">+ Create</a>
    </div>
    {% for article in articles %}
        <div class="grid grid-cols-3 gap-2 mt-4">
            <div class="w-auto h-auto bg-gray-200 hover:bg-gray-400 cursor-pointer rounded-lg p-4 transition-colors duration-200">
                <div class="w-full h-30 bg-white rounded-md flex items-center justify-center">IMAGE</div>
                <h2 class="my-4 font-bold text-xl text-center">{{ article.title }}</h2>
                <p>{{ article.description }}</p>
                <div class="mt-6 text-center">
                    <a href="{{ path('app_article_show', {'id': article.id}) }}" class="bg-yellow-300 px-4 rounded-md">show</a>
                    <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="bg-amber-800 px-4 rounded-md">edit</a>
                </div>
                <span class="text-[10px] font-light text-center">{{ article.createdAt ? article.createdAt|date('Y-m-d H:i:s') : '' }}</span>
            </div>
        </div>
    {% else %}
        <tr>
            <td colspan="6">no records found</td>
        </tr>
    {% endfor %}

{% endblock %}
