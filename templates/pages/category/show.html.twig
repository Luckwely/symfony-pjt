{% extends 'layouts/base.html.twig' %}
{% block title %}{{ category.title }} - MonBlog{% endblock %}

{% block body %}
<div class="bg-[#0d0e12] min-h-screen text-gray-300 antialiased">

    <!-- Hero Section -->
    <header class="relative bg-[#0d0e12] overflow-hidden border-b border-gray-800">
        <div class="absolute inset-0 z-0">
            <img src="{{ category.image ?: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&auto=format&fit=crop&w=2072&q=80' }}" 
                 alt="{{ category.title }}" 
                 class="w-full h-full object-cover opacity-20">
            <div class="absolute inset-0 bg-gradient-to-b from-[#0d0e12]/70 to-[#0d0e12]"></div>
        </div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
            <!-- Breadcrumb -->
            <nav class="mb-6 flex items-center gap-2 text-sm text-gray-500">
                <a href="{{ path('app_category_index') }}" class="hover:text-[#e01a8a] transition-colors">Catégories</a>
                <span>/</span>
                <span class="text-gray-300">{{ category.title }}</span>
            </nav>

            <h1 class="text-4xl md:text-5xl font-black text-white uppercase tracking-tight mb-4">
                {{ category.title }}
            </h1>
            <p class="text-lg text-gray-400 max-w-2xl italic">
                {{ category.description|striptags|slice(0, 120) }}{% if category.description|length > 120 %}...{% endif %}
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-3 mt-8">
                <a href="{{ path('app_category_index') }}" 
                   class="inline-flex items-center gap-2 border border-gray-600 text-gray-300 hover:text-white hover:border-[#e01a8a] px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Retour
                </a>
                <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                   class="inline-flex items-center gap-2 bg-[#e01a8a] hover:bg-[#c4185e] text-white px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all shadow-lg shadow-[#e01a8a]/30">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Modifier
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Left: Image + Description Card -->
            <div class="lg:col-span-2 space-y-8">
                
                <!-- Image Card -->
                <div class="bg-white rounded-2xl overflow-hidden shadow-xl">
                    <div class="h-72 md:h-96 relative overflow-hidden bg-gray-200">
                        <img src="{{ category.image ?: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80' }}" 
                             alt="{{ category.title }}" 
                             class="w-full h-full object-cover">
                        <span class="absolute top-4 left-4 bg-[#e01a8a] text-white text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider shadow-lg">
                            Catégorie
                        </span>
                    </div>
                </div>

                <!-- Description Card -->
                <div class="bg-white rounded-2xl p-8 shadow-xl">
                    <h2 class="text-2xl font-bold text-gray-900 uppercase tracking-wide mb-4 flex items-center gap-3">
                        <span class="w-1 h-8 bg-[#e01a8a] rounded-full"></span>
                        Description
                    </h2>
                    <div class="text-gray-600 leading-relaxed space-y-4">
                        {% if category.description %}
                            <p>{{ category.description }}</p>
                        {% else %}
                            <p class="text-gray-400 italic">Aucune description disponible pour cette catégorie.</p>
                        {% endif %}
                    </div>
                </div>

            </div>

            <!-- Right: Details Sidebar -->
            <aside class="space-y-8">
                
                <!-- Details Card -->
                <div class="bg-white rounded-2xl p-6 shadow-xl">
                    <h3 class="text-lg font-bold text-gray-900 uppercase tracking-wide mb-6 flex items-center gap-3">
                        <span class="w-1 h-6 bg-[#e01a8a] rounded-full"></span>
                        Détails
                    </h3>
                    
                    <dl class="space-y-5">
                        <!-- Title -->
                        <div class="border-b border-gray-100 pb-4">
                            <dt class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1 flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#e01a8a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                                Titre
                            </dt>
                            <dd class="text-gray-900 font-semibold">{{ category.title }}</dd>
                        </div>

                        <!-- Description -->
                        <div class="border-b border-gray-100 pb-4">
                            <dt class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1 flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#e01a8a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                                Description
                            </dt>
                            <dd class="text-gray-600 text-sm leading-relaxed">
                                {{ category.description ?: 'Non renseignée' }}
                            </dd>
                        </div>

                        <!-- Image -->
                        <div>
                            <dt class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1 flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#e01a8a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Image
                            </dt>
                            <dd class="text-gray-600 text-sm">
                                {% if category.image %}
                                    <a href="{{ category.image }}" target="_blank" class="text-[#e01a8a] hover:text-[#c4185e] font-medium break-all transition-colors">
                                        {{ category.image|length > 40 ? category.image|slice(0, 40) ~ '...' : category.image }}
                                    </a>
                                {% else %}
                                    <span class="text-gray-400 italic">Aucune image</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>

                <!-- Danger Zone -->
                <div class="bg-white rounded-2xl p-6 shadow-xl border border-red-100">
                    <h3 class="text-lg font-bold text-red-600 uppercase tracking-wide mb-4 flex items-center gap-3">
                        <span class="w-1 h-6 bg-red-600 rounded-full"></span>
                        Zone de danger
                    </h3>
                    <p class="text-gray-500 text-sm mb-4">Cette action est irréversible. Toutes les données associées seront définitivement supprimées.</p>
                    {# {{ include('category/_delete_form.html.twig') }} #}
                    <button type="button" 
                            class="w-full bg-red-600 hover:bg-red-700 text-white px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all shadow-lg shadow-red-600/30 flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Supprimer la catégorie
                    </button>
                </div>

            </aside>
        </div>
    </main>

</div>
{% endblock %}