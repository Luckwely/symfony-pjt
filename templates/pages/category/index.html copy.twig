{% extends 'layouts/base.html.twig' %}
{% block title %}Category{% endblock %}
{% block body %}
    <div class="flex justify-between items-center">
        <h1 class="text-4xl my-3 font-bold">Category List</h1>
        <a class="text-black " href="{{ path('app_category_new') }}">+ Create</a>
    </div>

    <table class="table border border-gray-400 w-full mt-2">
        <thead>
            <tr class="border border-gray-400">
                <th class="py-2 bg-black text-white">Id</th>
                <th class="py-2 bg-black text-white">Title</th>
                <th class="py-2 bg-black text-white">Description</th>
                <th class="py-2 bg-black text-white">Image</th>
                <th class="py-2 bg-black text-white">actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td class="text-center py-2">{{ category.id }}</td>
                <td class="text-center py-2">{{ category.title }}</td>
                <td class="text-center py-2">{{ category.description }}</td>
                <td class="text-center py-2">{{ category.image }}</td>
                <td class="text-center py-2">
                    <a href="{{ path('app_category_show', {'id': category.id}) }}" class="bg-amber-300 px-2 rounded-md">show</a>
                    <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="bg-blue-300 px-2 rounded-md">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
