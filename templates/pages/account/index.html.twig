{% extends 'layouts/base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}

{% if app.user %}
<section class="bg-slate-900 mt-3">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-4 py-8 text-center sm:flex-row sm:px-6 sm:text-left">
    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop&crop=faces" alt="Sophie"
      class="h-24 w-24 rounded-full border-4 border-pink-500 object-cover">
    <div>
      <h1 class="text-3xl font-extrabold uppercase tracking-wider text-white sm:text-4xl">Bonjour, <span
          class="text-pink-500">{{ app.user.firstname }}</span> !</h1>
      <p class="mt-1 italic text-slate-400">Bienvenue sur votre espace personnel</p>
    </div>
  </div>
</section>

<!-- Dashboard -->
<main class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-4">

  <!-- Sidebar -->
  <aside class="self-start rounded-2xl bg-white p-5 shadow-md lg:col-span-1">
    <div class="border-b border-slate-200 pb-5 text-center">
      <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop&crop=faces"
        alt="Sophie Martin" class="mx-auto h-20 w-20 rounded-full border-4 border-pink-500 object-cover">
      <p class="mt-3 font-bold">{{ app.user.firstname }} {{ app.user.lastname }}</p>
      <span class="text-[11px] font-bold uppercase tracking-wide text-pink-600">Membre Premium</span>
    </div>
    <nav class="mt-5 space-y-1 text-sm font-semibold uppercase tracking-wide">
      <a href="#" class="flex items-center gap-3 rounded-lg bg-pink-500 px-4 py-3 text-white shadow-sm">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
        </svg>Tableau de bord</a>
      <a href="#"
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-slate-700 transition hover:bg-pink-50 hover:text-pink-600">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
        </svg>Mon profil</a>
      <a href="#"
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-slate-700 transition hover:bg-pink-50 hover:text-pink-600">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 20h9M16.5 3.5l4 4L8 20l-5 1 1-5z" />
        </svg>Mes articles</a>
      <a href="#"
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-slate-700 transition hover:bg-pink-50 hover:text-pink-600">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M21 12a8 8 0 0 1-12 7l-6 2 2-5a8 8 0 1 1 16-4z" />
        </svg>Mes commentaires</a>
      <a href="#"
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-slate-700 transition hover:bg-pink-50 hover:text-pink-600">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 21s-8-5-8-11a4.5 4.5 0 0 1 8-3 4.5 4.5 0 0 1 8 3c0 6-8 11-8 11z" />
        </svg>Mes favoris</a>
      <a href="#"
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-slate-700 transition hover:bg-pink-50 hover:text-pink-600">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3" />
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2" />
        </svg>Paramètres</a>
      <hr class="my-3 border-slate-200">
      <a href="{{ logout_path() }}"
        class="flex items-center gap-3 rounded-lg px-4 py-3 text-red-700 transition hover:bg-red-50">
        <span class="h-3.5 w-3 rounded-sm bg-red-900"></span>Déconnexion</a>
    </nav>
  </aside>

  <!-- Content -->
  <div class="space-y-8 lg:col-span-3">

    <!-- Counters -->
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl bg-white p-6 text-center shadow-sm transition hover:shadow-md">
        <p class="text-3xl font-extrabold text-pink-500">{{ articleCount }}</p>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Articles</p>
      </div>
      <div class="rounded-2xl bg-white p-6 text-center shadow-sm transition hover:shadow-md">
        <p class="text-3xl font-extrabold text-pink-500">48</p>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Commentaires</p>
      </div>
      <div class="rounded-2xl bg-white p-6 text-center shadow-sm transition hover:shadow-md">
        <p class="text-3xl font-extrabold text-pink-500">156</p>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Favoris</p>
      </div>
    </div>

    <!-- Personal info -->
    <section class="rounded-2xl bg-white p-6 shadow-md sm:p-8">
      <div class="flex items-center justify-between border-b-4 border-pink-500 pb-4">
        <h2 class="text-xl font-extrabold uppercase tracking-wide sm:text-2xl">Informations personnelles</h2>
        <a href="#" class="flex items-center gap-1.5 text-xs font-bold uppercase text-pink-600 hover:text-pink-500">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M16.5 3.5l4 4L8 20l-5 1 1-5z" />
          </svg>Modifier</a>
      </div>
      <dl class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Prénom</dt>
          <dd class="mt-1">{{ app.user.firstname }}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Nom</dt>
          <dd class="mt-1">{{ app.user.lastname }}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Email</dt>
          <dd class="mt-1 break-all">{{ app.user.email }}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Téléphone</dt>
          <dd class="mt-1">06 12 34 56 78</dd>
        </div>
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Date d'inscription</dt>
          <dd class="mt-1">{{ app.user.createdAt|date() }}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Rôle</dt>
          <dd class="mt-1"><span
              class="inline-block rounded-full bg-pink-100 px-3 py-1 text-[11px] font-bold uppercase text-pink-600">{{ app.user.roles|join == "ROLE_USER" ? "USER" : (app.user.roles|join == "ROLE_ADMIN" ? "ADMIN" : "N/A") }}</span>
          </dd>
        </div>
      </dl>
    </section>

    <!-- Articles -->
    <section class="rounded-2xl bg-white p-6 shadow-md sm:p-8">
      <div class="flex items-center justify-between border-b-4 border-pink-500 pb-4">
        <h2 class="text-xl font-extrabold uppercase tracking-wide sm:text-2xl">Mes derniers articles</h2>
        <a href="#" class="text-xs font-bold uppercase text-pink-600 hover:text-pink-500">Voir tout →</a>
      </div>
      <ul class="mt-4 divide-y divide-slate-100">
        {% for article in articles %}
          <li class="flex items-center gap-4 py-4">
            <img src="{{ article.image }}" alt=""
              class="h-14 w-14 rounded-lg object-cover">
            <div class="min-w-0 flex-1">
              <p class="truncate font-bold">{{ article.title }}</p>
              <p class="text-xs text-slate-500">Publié le {{ article.createdAt|date() }}</p>
            </div>
            <span class="rounded-full bg-green-100 px-3 py-1 text-[11px] font-bold uppercase text-green-700">Publié</span>
          </li>
        {% endfor %}

      </ul>
    </section>
  </div>
</main>
{% endif %}
{% endblock %}
