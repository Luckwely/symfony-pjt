{% extends 'layouts/base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}

        <h1 class="h3 mb-3 font-weight-normal">Welcome</h1>
        <a href="{{ logout_path() }}">Logout</a>

        {% if app.user %}
            <div class="mb-3">
                <p>
                    Email: {{ app.user.userIdentifier }},
                </p>
            </div>
        {% endif %}

{% endblock %}
